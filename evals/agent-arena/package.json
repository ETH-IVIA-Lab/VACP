{
  "name": "@vacp/agent-arena",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-arena": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "prestart": "pnpm build",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "@opencode-ai/sdk": "1.17.3",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
