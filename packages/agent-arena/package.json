{
  "name": "@vacp/agent-arena",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "agent-arena": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "prestart": "pnpm build",
    "start": "node dist/cli.js",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.42",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
