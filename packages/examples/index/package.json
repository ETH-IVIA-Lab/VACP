{
  "name": "vacp-example-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-generated.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:full": "node scripts/sync-generated.mjs && pnpm --filter @vacp/debug-ui build && pnpm exec concurrently -k -n debug-ui,vite \"pnpm --filter @vacp/debug-ui dev:watch\" \"vite --host 127.0.0.1 --port 5173 --strictPort\"",
    "build": "node scripts/sync-generated.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "oxlint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vacp-example-cars-parallel-coords": "workspace:*",
    "vacp-example-react-dashboard": "workspace:*",
    "vacp-example-vega-lite-gallery": "workspace:*",
    "vacp-example-vgplot-gallery": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^7.3.1"
  }
}
