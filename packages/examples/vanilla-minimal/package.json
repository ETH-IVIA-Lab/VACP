{
  "name": "vacp-example-vanilla-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "pnpm exec concurrently -k -n debug-ui,vite \"pnpm --filter @vacp/debug-ui dev\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vacp/core": "workspace:*",
    "@vacp/debug-ui": "workspace:*",
    "@vacp/duckdb": "workspace:*",
    "@vacp/kit": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
