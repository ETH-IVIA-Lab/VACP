{
  "name": "@vacp/inspector",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b && tsc-alias -p tsconfig.json && pnpm run build:css",
    "build:css": "pnpm exec tailwindcss -i src/style.css -o dist/style.css",
    "dev": "pnpm run build && pnpm run dev:watch",
    "dev:watch": "pnpm exec concurrently -k -n tsc,alias,css \"pnpm run dev:tsc\" \"pnpm run dev:alias\" \"pnpm run dev:css\"",
    "dev:tsc": "tsc -b -w --preserveWatchOutput",
    "dev:alias": "tsc-alias -p tsconfig.json -w",
    "dev:css": "pnpm exec tailwindcss -i src/style.css -o dist/style.css --watch",
    "typecheck": "tsc -b",
    "test": "pnpm exec tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.286",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@radix-ui/react-roving-focus": "^1.1.19",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "catalog:",
    "@uiw/react-codemirror": "^4.25.11",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "@vacp/agent-ai-sdk": "workspace:*",
    "@vacp/diagram-mermaid": "workspace:*",
    "@vacp/protocol": "workspace:*",
    "@vacp/runtime-browser": "workspace:*",
    "@vacp/transport-bridge": "workspace:*",
    "@xyflow/react": "^12.11.6",
    "apache-arrow": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "streamdown": "^2.6.0",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsc-alias": "^1.9.5",
    "tsx": "catalog:"
  }
}
