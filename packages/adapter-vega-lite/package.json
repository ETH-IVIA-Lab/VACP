{
  "name": "@vacp/adapter-vega-lite",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "default": "./dist/presentation.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TZ=America/Los_Angeles tsx --test --test-timeout=10000 test/*.test.ts",
    "bench": "tsx bench/observation.ts && tsx bench/data.ts"
  },
  "dependencies": {
    "@vacp/data-duckdb": "workspace:*",
    "@vacp/presence-browser": "workspace:*",
    "@vacp/presence-core": "workspace:*",
    "@vacp/protocol": "workspace:*",
    "@vacp/runtime": "workspace:*"
  },
  "devDependencies": {
    "@duckdb/node-api": "catalog:"
  },
  "peerDependencies": {
    "vega": "*",
    "vega-embed": "*",
    "vega-lite": "*"
  }
}
