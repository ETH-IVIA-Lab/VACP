{
  "name": "@vacp/presence-browser",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "NOTICE",
    "licenses"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "default": "./dist/targets.js"
    },
    "./streamdown": {
      "types": "./dist/streamdown.d.ts",
      "default": "./dist/streamdown.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-timeout=10000 test/*.test.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:",
    "@vacp/presence-core": "workspace:*",
    "@vacp/protocol": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "catalog:"
  }
}
