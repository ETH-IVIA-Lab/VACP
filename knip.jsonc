{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Vendored plugin code is validated by its own rule tests and type check.
  "ignore": ["tools/oxlint/anti-slop/**"],
  // Make is supplied by the host.
  "ignoreBinaries": ["make"],
  "workspaces": {
    ".": {
      "entry": ["vite.shared.ts", "tools/oxlint/anti-slop/**/*.test.ts", "examples/custom-integration/threshold.ts"],
    },
    "scripts": {
      "entry": ["*.ts"],
    },
    "examples/gallery": {
      "entry": ["examples.manifest.ts", "vite.config.ts"],
      "vite": { "config": "vite.config.ts" },
    },
    "apps/e2e": {
      // Browser fixtures load through Vite's /@fs route; setup files run as a Playwright project.
      "entry": ["fixtures/presence.ts", "fixtures/inspection.ts", "fixtures/webmcp.ts", "tests/*.setup.ts"],
    },
    "apps/evals": {
      // src/index.ts is the authoring API that suites and scenarios build on.
      "entry": ["evals.config.ts", "src/index.ts", "test/*.test.ts"],
    },
    "packages/agent-ai-sdk": {
      // @ai-sdk/provider's public declarations import json-schema, whose types it omits from dependencies.
      "ignoreDependencies": ["@types/json-schema"],
    },
    "apps/docs": {
      // VitePress loads this optional minifier dynamically for Rolldown builds.
      "ignoreDependencies": ["oxc-minify"],
    },
  },
}
