{
  "name": "vacp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "postinstall": "pnpm -r --filter @vacp/* build",
    "build:examples-hub": "node scripts/examples-hub-build.mjs",
    "dev:mosaic": "pnpm --filter vacp-example-mosaic-gallery dev:full",
    "dev:vega-lite": "pnpm --filter vacp-example-vega-lite-gallery dev:full",
    "dev:cars": "pnpm --filter vacp-example-cars-parallel-coords dev:full",
    "dev:react-dashboard": "pnpm --filter vacp-example-react-dashboard dev:full",
    "dev:examples": "node scripts/examples-hub-dev.mjs",
    "dev:examples:posthog": "VACP_POSTHOG_API_KEY=phc_IbpHrcaOBqVCTARECzfuOO4nw0B0ViSE4eLwyAnw7Oo VACP_POSTHOG_API_HOST=https://us.i.posthog.com VACP_POSTHOG_DEFAULTS=2025-11-30 VACP_POSTHOG_CAPTURE_SNAPSHOTS=0 pnpm dev:examples",
    "start:examples": "pnpm build:examples-hub && node scripts/examples-hub-start.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:examples": "pnpm -r --filter @vacp/* build && pnpm exec playwright test",
    "test:server": "cd packages/vacp-mcp-server && uv run pytest",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.9",
    "concurrently": "^9.2.1",
    "http-proxy": "^1.18.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.41.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
