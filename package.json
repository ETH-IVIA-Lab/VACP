{
  "name": "vacp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter vacp-example-index dev:full",
    "docs:dev": "pnpm --filter @vacp/docs dev",
    "docs:build": "pnpm --filter @vacp/docs build",
    "docs:preview": "pnpm --filter @vacp/docs preview",
    "build:examples": "pnpm --filter 'vacp-example-index...' build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:e2e && pnpm test:mcp",
    "test:e2e": "pnpm --filter @vacp/e2e test",
    "test:mcp": "cd packages/lib/transports/mcp-server && uv run pytest",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.51.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
