{
  "name": "vacp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "postinstall": "pnpm -r --filter @vacp/* build",
    "dev:mosaic": "pnpm --filter vacp-example-mosaic-gallery dev",
    "dev:vega-lite": "pnpm --filter vacp-example-vega-lite-gallery dev",
    "dev:d3-lasso": "pnpm --filter vacp-example-d3-scatter-lasso dev",
    "dev:vanilla": "pnpm --filter vacp-example-vanilla-minimal dev",
    "dev:react-dashboard": "pnpm --filter vacp-example-react-dashboard dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:examples": "pnpm -r --filter @vacp/* build && pnpm exec playwright test",
    "test:server": "cd packages/vacp-mcp-server && uv run pytest",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.6",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.38.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.15.1"
}
