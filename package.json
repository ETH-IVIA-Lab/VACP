{
  "name": "vacp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter vacp-example-index dev:full",
    "docs:dev": "pnpm --filter @vacp/docs dev",
    "docs:build": "pnpm --filter @vacp/docs build",
    "docs:preview": "pnpm --filter @vacp/docs preview",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:e2e && pnpm test:mcp",
    "test:e2e": "pnpm --filter @vacp/e2e test",
    "test:mcp": "cd packages/lib/transports/mcp-server && uv run pytest",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.51.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
